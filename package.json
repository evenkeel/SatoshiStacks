{
  "name": "satoshistacks",
  "version": "1.0.0",
  "description": "Play-money poker platform with Lightning integration path",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install && npm install --workspace=packages/backend",
    "dev": "npm run dev --workspace=packages/backend",
    "start": "npm start --workspace=packages/backend",
    "test": "node --test packages/shared/hand-evaluator.test.js packages/backend/poker-game.test.js packages/backend/poker-game.lifecycle.test.js"
  },
  "keywords": [
    "poker",
    "bitcoin",
    "lightning"
  ],
  "author": "Noah Rexrode",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "puppeteer": "^24.37.3"
  }
}
