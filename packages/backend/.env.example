# SatoshiStacks Configuration
# Copy this to .env and customize for your environment

# Server port
PORT=3001

# Node environment: development or production
NODE_ENV=production

# CORS origin — your domain for production
# For multiple origins: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGIN=https://yourdomain.com

# Admin dashboard token — CHANGE THIS!
ADMIN_TOKEN=your-secret-admin-token-here

# Nostr server identity (nsec) — used for publishing badges and live activities
# Generate one: node -e "const {generateSecretKey}=require('nostr-tools/pure');const {nsecEncode}=require('nostr-tools/nip19');console.log(nsecEncode(generateSecretKey()))"
NOSTR_SERVER_NSEC=your-server-nsec-here

# ==================== LIGHTNING / REAL MONEY ====================
# Master switch. Leave false (or unset) for play-money. When true, tables flagged
# realMoney accept real sats and ALL the vars below become REQUIRED (the server
# refuses to boot otherwise). Start on regtest, then signet, then mainnet.
REALMONEY_ENABLED=false

# Kill switch for outbound payments. Set to false to instantly freeze all cash-outs
# (gameplay + deposits continue). Default on.
WITHDRAWALS_ENABLED=true

# Which network the LND node is on: regtest | signet | mainnet
LIGHTNING_NETWORK=regtest

# LND gRPC connection. Use a RESTRICTED macaroon (only AddInvoice/SubscribeInvoices/
# SendPayment/TrackPayment/GetInfo) — NEVER the admin macaroon.
LND_HOST=127.0.0.1
LND_PORT=10009
LND_MACAROON_PATH=/path/to/poker.macaroon
LND_TLS_CERT_PATH=/path/to/tls.cert
LND_PROTO_PATH=/path/to/lightning.proto
# Our own node pubkey — used to reject self-pay-loop withdrawal invoices.
LND_OWN_PUBKEY=

# Exposure caps (REQUIRED when REALMONEY_ENABLED=true). Keep the hot-wallet float
# small; bulk funds belong in cold storage.
HOT_WALLET_CAP_SATS=1000000
MAX_WITHDRAWAL_SATS=100000
MIN_WITHDRAWAL_SATS=1000
WITHDRAWAL_FEE_LIMIT_SATS=50
INVOICE_EXPIRY_SEC=600
